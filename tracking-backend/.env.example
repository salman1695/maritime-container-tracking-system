# Application environment
APP_ENV=development

# SafeCube API and webhook secrets
SAFECUBE_BASE_URL=https://api.sinay.ai/container-tracking/api/v2
SAFECUBE_API_KEY=your_safecube_api_key_here
SAFECUBE_WEBHOOK_SECRET=your_webhook_secret_here

# AISStream API key for terrestrial vessel tracking
AISSTREAM_API_KEY=your_aisstream_api_key_here

# PostgreSQL connection string for local Docker container
DATABASE_URL=postgresql+asyncpg://tracking_user:tracking_password@localhost:5432/tracking_db

# Redis connection string for local Docker container
REDIS_URL=redis://localhost:6379/0